# Firebase Configuration (Optional — required only for Cloud Sync & Authentication)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Cloud AI Assistant Configuration (Optional — can also be configured in-app under Settings)
# Google Gemini (Free tier at https://aistudio.google.com/app/apikey)
EXPO_PUBLIC_GEMINI_API_KEY=

# Groq (Free tier at https://console.groq.com/keys)
EXPO_PUBLIC_GROQ_API_KEY=

# OpenAI
EXPO_PUBLIC_OPENAI_API_KEY=
