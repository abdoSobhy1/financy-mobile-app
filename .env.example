# Firebase Configuration (Optional — required only for Cloud Sync & Authentication)
# These Firebase client identifiers are public; access is controlled by Auth, Security Rules, and App Check.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
# Public URL of the deployed Cloudflare Worker (not a secret).
EXPO_PUBLIC_GEMINI_WORKER_URL=https://financy-gemini-gateway.your-subdomain.workers.dev
# Never add AI provider keys to EXPO_PUBLIC variables: Expo embeds them in the application bundle.
# Set the app-owned Gemini key as a Cloudflare Worker secret with `wrangler secret put GEMINI_API_KEY`.
# Personal provider keys entered in Settings are stored using Expo SecureStore on the device.
