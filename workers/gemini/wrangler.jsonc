{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financy-gemini-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FIREBASE_PROJECT_ID": "strapicms1"
  },
  "d1_databases": [
    {
      "binding": "AI_USAGE",
      "database_name": "financy-ai-usage",
      "database_id": "c2c22e66-9ada-4d5f-94e0-0b805ca1e9e8",
      "migrations_dir": "migrations"
    }
  ]
}
